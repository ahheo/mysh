#!/usr/bin/env bash
#

if [[ "$(uname -s)" == *Darwin* ]] ; then
  grep_=`which ggrep`
else
  grep_=`which grep`
fi
if test -z "$grep_" ; then
  echo "We use ggrep/gsed instead of grep/gsed in Darwin system following GNU style!"
  echo "ggrep/gsed is available through \"brew install grep\"/\"brew install sed\"!"
  exit 1
fi

bold=$(tput bold)
normal=$(tput sgr0)
me=$(basename "$0")
rsl="rsl.error.0000"
_v=""
while test $# -gt 0; do
  case "$1" in
    -h|--help)
      echo "${bold}$me - get \"current time\" of a running WRF simulation from a RSLFILE${normal}"
      echo " "
      echo "${bold}usage:${normal} $me [RSLFILE]"
      echo "        if RSLFILE not specified, rsl.error.0000 in the current directory will be used!"
      echo " "
      echo "options:"
      echo "-h, --help                show brief help"
      echo "-v                        more message"
      exit 0
      ;;
    -v)
      _v="1"
      shift
      ;;
    *)
      if test $# -gt 0; then
        if test -d "$1" ; then 
          rsl="$1/${rsl}"
        else
          rsl="$1"
        fi
        shift
      fi
      ;;
  esac
done

if [ ! -f "$rsl" ] ; then 
  if test "$_v" ; then echo "File '${rsl}' does not exist!!! Exit!" ; fi
  exit 0
fi

node0=$(head -1 "$rsl" | grep -oP "hostname: \K[^[:space:]]*")
squeue --node="$node0" -u $USER -o "%i" --noheader
